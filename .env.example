# ==========================================
# ATLAS-EO Environment Configuration Template
# ==========================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atlaseo
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_secret_pass

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Qdrant Vector Store Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Ollama LLM Service Configuration
OLLAMA_HOST=http://localhost:11434
DEFAULT_LLM_MODEL=qwen3:8b
DEFAULT_EMBEDDING_MODEL=nomic-embed-text

# Google Earth Engine Configuration
# Create a GEE service account at: https://console.cloud.google.com
# Register your project at: https://code.earthengine.google.com/
GEE_PROJECT_ID=your-gee-project-id
GEE_SERVICE_ACCOUNT=your-sa@your-project.iam.gserviceaccount.com
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GEE_CACHE_TTL_SEC=600
